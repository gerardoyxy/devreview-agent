  "components": [
    {
      "name": "Landing source button",
      "kind": "button",
      "refersTo": "landing-source-button",
      "description": "White source action for the blue landing field.",
      "html": "<a class=\"ds-source\" href=\"#source\">View on GitHub <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></a>",
      "css": ".ds-source{display:inline-flex;align-items:center;justify-content:center;gap:21px;min-height:65px;padding:14px 33px;border:1px solid transparent;border-radius:6px;background:#fff;color:#111839;font:700 23px/1.5 Archivo,system-ui,sans-serif;text-decoration:none}.ds-source svg{width:26px;height:26px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}.ds-source:hover{background:#edf1ff}.ds-source:focus-visible{outline:3px solid #fff;outline-offset:5px}"
    },
    {
      "name": "Landing accent button",
      "kind": "button",
      "refersTo": "landing-primary-button",
      "description": "Closing source action on the normal landing page surface.",
      "html": "<a class=\"ds-site-primary\" href=\"#source\">View on GitHub</a>",
      "css": ".ds-site-primary{display:inline-flex;align-items:center;justify-content:center;min-height:58px;padding:14px 24px;border:1px solid transparent;border-radius:6px;background:var(--accent,#2147cc);color:var(--on-accent,#fff);font:700 16px/1.5 Archivo,system-ui,sans-serif;text-decoration:none}.ds-site-primary:hover{filter:brightness(.94)}.ds-site-primary:focus-visible{outline:3px solid var(--accent,#2147cc);outline-offset:5px}"
    },
    {
      "name": "Application primary action",
      "kind": "button",
      "refersTo": "app-primary-button",
      "description": "Dashboard action; inherits the saved palette and radius.",
      "html": "<button class=\"ds-primary\">Inspect playground</button>",
      "css": ".ds-primary{font-family:var(--dr-font-body, \"NudgeThis Archivo\", system-ui, sans-serif);font-size:var(--dr-size, 14px);line-height:1.6;border-radius:var(--dr-radius, 6px);cursor:pointer;background:var(--dr-accent,#2147cc);color:var(--dr-onAccent,#fff);border:1px solid var(--dr-accent,#2147cc);padding:11px 16px;font-size:calc(var(--dr-size,14px)*.9286);font-weight:700}.ds-primary:hover{filter:brightness(.94)}.ds-primary:focus-visible{outline:2px solid var(--dr-accent, #2147cc);outline-offset:3px;outline-offset:4px}.ds-primary:disabled{opacity:.5;cursor:wait}"
    },
    {
      "name": "Application secondary action",
      "kind": "button",
      "refersTo": "app-secondary-button",
      "description": "Shared review secondary action.",
      "html": "<button class=\"ds-secondary\">Retry from HEAD</button>",
      "css": ".ds-secondary{font-family:var(--dr-font-body, \"NudgeThis Archivo\", system-ui, sans-serif);font-size:var(--dr-size, 14px);line-height:1.6;border-radius:var(--dr-radius, 6px);cursor:pointer;background:var(--dr-surface,#fff);color:var(--dr-text,#172143);border:1px solid var(--dr-border,#bdc8de);padding:8px 11px;font-size:calc(var(--dr-size,14px)*.8571)}.ds-secondary:hover{background:var(--dr-elevated,#edf1ff);border-color:var(--dr-accent,#2147cc)}.ds-secondary:focus-visible{outline:2px solid var(--dr-accent, #2147cc);outline-offset:3px;}.ds-secondary:disabled{opacity:.5;cursor:default}"
    },
    {
      "name": "Follow-up composer field",
      "kind": "input",
      "refersTo": "app-composer-field",
      "description": "Resizable text field for a continuing conversation.",
      "html": "<label class=\"ds-field-label\" for=\"ds-message\">Message to the agent</label><textarea id=\"ds-message\" class=\"ds-field\" placeholder=\"Ask a question or describe the next adjustment…\"></textarea>",
      "css": ".ds-field-label{font-family:var(--dr-font-body, \"NudgeThis Archivo\", system-ui, sans-serif);font-size:var(--dr-size, 14px);line-height:1.6;display:block;margin-bottom:6px;color:var(--dr-muted,#566480);font-size:calc(var(--dr-size,14px)*.8571)}.ds-field{font-family:var(--dr-font-body, \"NudgeThis Archivo\", system-ui, sans-serif);font-size:var(--dr-size, 14px);line-height:1.6;display:block;width:100%;min-height:78px;max-height:160px;resize:vertical;padding:10px 12px;border:1px solid var(--dr-border,#bdc8de);border-radius:var(--dr-radius,6px);background:var(--dr-surface,#fff);color:var(--dr-text,#172143);caret-color:var(--dr-accent,#2147cc)}.ds-field::placeholder{color:var(--dr-muted,#566480)}.ds-field:focus-visible{outline:2px solid var(--dr-accent, #2147cc);outline-offset:3px;}"
    },
    {
      "name": "Queue navigation",
      "kind": "nav",
      "refersTo": "app-navigation-selected",
      "description": "Selected queue filter, with an actual count and a selected state.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Queue filters\"><button class=\"ds-nav-item\" aria-current=\"page\"><span>Review queue</span><b>3</b></button><button class=\"ds-nav-item\"><span>Ready to apply</span><b>2</b></button></nav>",
      "css": ".ds-nav{display:grid;gap:3px}.ds-nav-item{font-family:var(--dr-font-body, \"NudgeThis Archivo\", system-ui, sans-serif);font-size:var(--dr-size, 14px);line-height:1.6;display:flex;align-items:center;justify-content:space-between;gap:10px;text-align:left;border:1px solid transparent;border-radius:var(--dr-radius,6px);padding:10px;background:transparent;color:var(--dr-muted,#566480);cursor:pointer}.ds-nav-item:hover{background:var(--dr-page,#f4f6ff)}.ds-nav-item[aria-current]{background:var(--dr-accentSoft,#e7edff);color:var(--dr-accent,#2147cc);font-weight:700}.ds-nav-item b{font-size:calc(var(--dr-size,14px)*.8571);font-weight:400;font-variant-numeric:tabular-nums}.ds-nav-item:focus-visible{outline:2px solid var(--dr-accent, #2147cc);outline-offset:3px;outline-offset:4px}"
    },
    {
      "name": "Ready status",
      "kind": "chip",
      "refersTo": "app-ready-badge",
      "description": "Success badge keeps the status readable alongside color.",
      "html": "<span class=\"ds-ready\">Ready for review</span>",
      "css": ".ds-ready{font-family:var(--dr-font-body, \"NudgeThis Archivo\", system-ui, sans-serif);font-size:var(--dr-size, 14px);line-height:1.6;display:inline-flex;align-items:center;gap:6px;border-radius:calc(var(--dr-radius,6px)*.65);font-size:calc(var(--dr-size,14px)*.7857);padding:4px 7px;background:var(--dr-successSoft,#e7f4eb);color:var(--dr-success,#21633d)}.ds-ready::before{content:\"\";height:5px;width:5px;border-radius:50%;background:currentColor}"
    },
    {
      "name": "Queue container",
      "kind": "card",
      "refersTo": "app-queue-container",
      "description": "One framed queue with a ruled heading and rows.",
      "html": "<section class=\"ds-queue\"><header class=\"ds-queue-heading\"><h2>Review queue</h2><p>Read the conversation. Review the change.</p></header><div class=\"ds-queue-row\">Give the button more space</div></section>",
      "css": ".ds-queue{font-family:var(--dr-font-body, \"NudgeThis Archivo\", system-ui, sans-serif);font-size:var(--dr-size, 14px);line-height:1.6;border:1px solid var(--dr-border,#bdc8de);border-radius:var(--dr-radius,6px);background:var(--dr-surface,#fff);color:var(--dr-text,#172143)}.ds-queue-heading{padding:23px 24px;border-bottom:1px solid var(--dr-border,#bdc8de)}.ds-queue-heading h2{margin:0 0 6px;font:700 calc(var(--dr-size,14px)*1.2857)/1.3 var(--dr-font-heading,\"NudgeThis Archivo\",system-ui,sans-serif);letter-spacing:-.02em}.ds-queue-heading p{margin:0;color:var(--dr-muted,#566480);font-size:calc(var(--dr-size,14px)*.8571)}.ds-queue-row{padding:19px 24px;font-weight:700}.ds-queue-row:hover{background:var(--dr-page,#f4f6ff)}"
    },
    {
      "name": "Review tabs",
      "kind": "nav",
      "refersTo": "app-review-tab",
      "description": "Separate conversation, patch, version history and captured context.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\" aria-label=\"Task details\"><button class=\"ds-tab\" role=\"tab\" aria-selected=\"true\">Conversation</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\">Changes</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\">History</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\">Context used</button></div>",
      "css": ".ds-tabs{display:flex;flex-wrap:wrap;gap:24px;padding:0 26px;border-bottom:1px solid var(--dr-border,#bdc8de)}.ds-tab{font-family:var(--dr-font-body, \"NudgeThis Archivo\", system-ui, sans-serif);font-size:var(--dr-size, 14px);line-height:1.6;padding:11px 0;border:0;border-bottom:2px solid transparent;background:none;color:var(--dr-muted,#566480);font-size:calc(var(--dr-size,14px)*.8571);cursor:pointer}.ds-tab[aria-selected=true]{border-bottom-color:var(--dr-accent,#2147cc);color:var(--dr-accent,#2147cc);font-weight:700}.ds-tab:focus-visible{outline:2px solid var(--dr-accent, #2147cc);outline-offset:3px;}"
    },
    {
      "name": "Live selection outline",
      "kind": "custom",
      "refersTo": "app-selection-outline",
      "description": "Themeable inspection outline; landing lemon handles are a separate illustration treatment.",
      "html": "<div class=\"ds-selection\" aria-label=\"Selected page element\"></div>",
      "css": ".ds-selection{position:relative;width:180px;height:50px;border:2px solid var(--dr-accent,#2147cc);border-radius:3px;background:color-mix(in srgb,var(--dr-accent,#2147cc) 7%,transparent)}.ds-selection::before,.ds-selection::after{content:\"\";position:absolute;width:7px;height:7px;background:var(--dr-warningSoft,#fff3d7);border:1px solid var(--dr-warning,#76510d)}.ds-selection::before{left:-4px;top:-4px}.ds-selection::after{right:-4px;bottom:-4px}"
