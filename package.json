{
  "name": "devreview-agent",
  "version": "0.1.0-alpha.2",
  "description": "Turn feedback on localhost into isolated, reviewable coding-agent tasks.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=24.15.0" },
  "bin": { "devreview": "packages/cli/src/index.js" },
  "exports": {
    "./overlay": "./packages/overlay/src/index.js",
    "./core": "./packages/core/src/index.js",
    "./agent-sdk": "./packages/agent-sdk/src/index.js"
  },
  "scripts": {
    "start": "node packages/cli/src/index.js start",
    "demo": "node scripts/demo.js",
    "check": "node scripts/check.js",
    "test": "node --test tests/*.test.js"
  }
}
