{
  "name": "nudgethis",
  "version": "0.7.0-alpha.1",
  "description": "Turn feedback on localhost into isolated, reviewable coding-agent tasks.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "exports": {
    "./overlay": "./dist/browser/overlay.js"
  },
  "scripts": {
    "start": "cargo run --locked --bin nudgethis -- start",
    "demo": "cargo run --locked --bin nudgethis -- demo",
    "build": "npm run build:frontend && cargo build --locked",
    "build:frontend": "tsc --noEmit && node scripts/build-frontend.js",
    "build:site": "tsc --project apps/site/tsconfig.json && node scripts/build-site.js",
    "check": "tsc --noEmit && node scripts/check.js",
    "test": "node --test tests/*.safe.test.js",
    "test:agents": "node scripts/test-agents.js",
    "package:release": "node scripts/package-release.js"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "esbuild": "0.28.2",
    "marked": "18.0.13",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  }
}
