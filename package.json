{
  "name": "nudgethis",
  "version": "0.2.0-alpha.1",
  "description": "Turn feedback on localhost into isolated, reviewable coding-agent tasks.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "bin": {
    "nudgethis": "packages/cli/src/index.js"
  },
  "exports": {
    "./overlay": "./dist/browser/overlay.js",
    "./core": "./packages/core/src/index.js",
    "./agent-sdk": "./packages/agent-sdk/src/index.js"
  },
  "scripts": {
    "start": "node packages/cli/src/index.js start",
    "demo": "node scripts/demo.js",
    "build": "npm run build:frontend && cargo build --locked",
    "build:frontend": "tsc --noEmit && node scripts/build-frontend.js",
    "check": "tsc --noEmit && node scripts/check.js",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
